//@version=6
indicator("EMA 5x50 Cross → Webhook", overlay = true)

// ---------- Inputs ----------
fastLen   = input.int(5,  "Fast EMA", minval = 1)
slowLen   = input.int(50, "Slow EMA", minval = 1)
sendBull  = input.bool(true, "Send Crossover (bullish) alerts")
sendBear  = input.bool(true, "Send Crossunder (bearish) alerts")

// ---------- Calc ----------
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
bull    = ta.crossover(emaFast, emaSlow)
bear    = ta.crossunder(emaFast, emaSlow)

plot(emaFast, "EMA 5",  color = color.new(color.aqua, 0),   linewidth = 2)
plot(emaSlow, "EMA 50", color = color.new(color.orange, 0), linewidth = 2)
plotshape(bull, "Bull cross", shape.triangleup,   location.belowbar, color.lime, size = size.small)
plotshape(bear, "Bear cross", shape.triangledown, location.abovebar, color.red,  size = size.small)

// ---------- Message ----------
// Examples sent to the webhook:
//   IDEA261027C13 EMA 5x50 Crossover TF=15 TIME=2026-10-07 10:15 PRICE=2.35
//   RELIANCE EMA 5x50 Crossunder TF=60 TIME=2026-10-07 11:15 PRICE=1412.5
sym  = syminfo.ticker
tf   = timeframe.period                       // "5", "15", "60", "240", "D", "W" ...
tm   = str.format_time(time, "yyyy-MM-dd HH:mm", "Asia/Kolkata")
px   = str.tostring(close, format.mintick)

if bull and sendBull
    alert(sym + " EMA 5x50 Crossover TF=" + tf + " TIME=" + tm + " PRICE=" + px, alert.freq_once_per_bar_close)

if bear and sendBear
    alert(sym + " EMA 5x50 Crossunder TF=" + tf + " TIME=" + tm + " PRICE=" + px, alert.freq_once_per_bar_close)
